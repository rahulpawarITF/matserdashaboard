# ========================================
# Master Dashboard - Environment Variables
# ========================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# ----- Application -----
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# ----- MongoDB -----
# For Docker Compose, use service name: mongo
MONGODB_URI=mongodb://mongo:27017/masterdashboard
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme_strong_password
MONGO_INITDB_DATABASE=masterdashboard

# ----- Redis -----
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ----- JWT -----
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_64_char_hex_from_openssl_rand
JWT_REFRESH_SECRET=replace_with_different_64_char_hex

# ----- Encryption -----
# 32-byte hex key: openssl rand -hex 32
# WARNING: Losing this key means encrypted credentials are UNRECOVERABLE
MASTER_ENCRYPTION_KEY=replace_with_64_char_hex_from_openssl_rand

# ----- Feature Flags -----
ENABLE_SWAGGER=true
DATA_RETENTION_DAYS=90
DEFAULT_CHECK_INTERVAL_MINUTES=5

# ----- Frontend (Vite env vars, prefix with VITE_) -----
VITE_API_URL=/api
VITE_SOCKET_URL=

# ----- Analytics -----
DEFAULT_GA4_PROPERTY_ID=554293933
